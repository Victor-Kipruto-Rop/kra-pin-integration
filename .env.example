# Copy to .env and fill in. NEVER commit .env.
KRA_ENVIRONMENT=sandbox
KRA_MOCK=true                      # set to false once you have KRA credentials

KRA_PIN_CONSUMER_KEY=
KRA_PIN_CONSUMER_SECRET=
# Only if KRA issued separate credentials for "PIN Checker By ID":
KRA_PIN_BY_ID_CONSUMER_KEY=
KRA_PIN_BY_ID_CONSUMER_SECRET=

# Keys your own backends send as X-API-Key (comma-separated). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_API_KEYS=change-me

REQUIRE_CONSENT=true
RATE_LIMIT_PER_MINUTE=30
INCLUDE_RAW_RESPONSE=false
# STRICT_PIN_FORMAT=true           # defaults to true only in production
# CORS_ORIGINS=https://app.example.com
# KRA_TIMEOUT_SECONDS=15

# Separate direct eTIMS OSCU sandbox integration; disabled by default.
ETIMS_OSCU_ENABLED=false
ETIMS_OSCU_CONSUMER_KEY=
ETIMS_OSCU_CONSUMER_SECRET=
ETIMS_OSCU_APP_ID=
ETIMS_OSCU_TIN=
ETIMS_OSCU_BHF_ID=
ETIMS_OSCU_CMC_KEY=
# ETIMS_OSCU_TIMEOUT_SECONDS=20

# Shared idempotency storage. Required for production; local dev may omit it.
# Use a private Redis/Valkey endpoint with TLS/authentication in hosted environments.
IDEMPOTENCY_REDIS_URL=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDEMPOTENCY_ENCRYPTION_KEY=
IDEMPOTENCY_TTL_SECONDS=604800
